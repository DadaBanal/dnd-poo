{
  "_": [
    "Every deliberate decision the SQLite -> T-SQL port needs, one per column.",
    "SQLite has one string type and one float type; SQL Server does not, and a",
    "width picked by a rule is a width nobody chose. So this file is explicit and",
    "the translator REFUSES to emit anything for a TEXT or REAL column that is not",
    "named here. Adding a column to schema/*.sql therefore breaks the build until",
    "somebody decides how wide it is -- which is the point.",
    "",
    "Reviewed 9 September 2026. NOT VERIFIED against DND-SQL01: this session has no",
    "route to it, so no width here has been proved against real data in the target."
  ],
  "classes": {
    "ID": {
      "sql": "NVARCHAR(64)",
      "why": "Keys and foreign keys. The longest in circulation is a desk reference like 'ITO-1723' and the longest catalogue id seeded is 24 characters."
    },
    "CODE": {
      "sql": "NVARCHAR(32)",
      "why": "A closed vocabulary. The longest value in any CHECK list is PAUSED_PENDING_AUTHORISATION at 28. The translator asserts this per column rather than trusting the note."
    },
    "NAME": {
      "sql": "NVARCHAR(400)",
      "why": "A name, title or heading a person reads. Scope item 3's verbatim heading is 62 characters; 400 leaves room without inviting a paragraph."
    },
    "PERSON": {
      "sql": "NVARCHAR(200)",
      "why": "A named person or a named group. Never a role alone, which is why it is not a CODE."
    },
    "REF": {
      "sql": "NVARCHAR(400)",
      "why": "A pointer to something outside the spine: a SharePoint item id, a desk reference, an evidence string kept verbatim. Long because the register's evidence cells carry absolute paths."
    },
    "HASH": {
      "sql": "NVARCHAR(64)",
      "why": "A sha256 in lower-case hex. Exactly 64."
    },
    "DATE_TEXT": {
      "sql": "NVARCHAR(32)",
      "why": "A date kept as the source wrote it. Both '20260904' and '2026-09-09' are in circulation and converting on the way in destroys which shape was used, so the text is authoritative and a parsed DATE column is added beside it."
    },
    "TIMESTAMP_TEXT": {
      "sql": "NVARCHAR(64)",
      "why": "As DATE_TEXT, but the source may carry a time and an offset. Parsed beside it as DATETIME2."
    },
    "FREE": {
      "sql": "NVARCHAR(MAX)",
      "why": "MAX only where the record says MAX: notes, details, bodies, reasons. The register's free-text cells run to thousands of characters and truncating one loses the running history of a workstream."
    },
    "TIME_TEXT": {
      "sql": "NVARCHAR(8)",
      "why": "A time of day as 'HH:MM', or NULL meaning the calendar is closed that day. Eight characters leaves room for 'HH:MM:SS' if a shift ever needs seconds; nothing here needs a full DATETIME."
    },
    "PATIENT_REF": {
      "sql": "NVARCHAR(64)",
      "why": "A record number pointing at the system that is actually the record of care, and nothing else -- no name, no date of birth, no diagnosis (013, and §6.1). Deliberately narrower than REF: the width is part of the control, because a column that cannot hold a paragraph cannot quietly become a second copy of the chart."
    },
    "DIGEST": {
      "sql": "NVARCHAR(256)",
      "why": "A salted scrypt digest in the shape 'scrypt$N$r$p$salt_hex$hash_hex': about 150 characters as psaspine writes it today. Never a password."
    },
    "KEY": {
      "sql": "NVARCHAR(200)",
      "why": "A machine's dedup key for an alert, part of a clustered primary key with a 64-character board id. SQL Server caps a clustered key at 900 bytes (found on the first apply, 26 Sep 2026: REF's 400 made it 928); 200 characters keep it at 528 and are more than an alert key needs. The API refuses a longer one."
    }
  },
  "decimals": {
    "fee_line.amount": {
      "sql": "DECIMAL(19,4)",
      "why": "Money on an invoice line. FLOAT cannot represent a cent exactly and this number is disputed by a finance function."
    },
    "variation.eac_percent": {
      "sql": "DECIMAL(9,4)",
      "why": "The uplift multiplier: PMA = BMF x EAC%. It reaches an invoice through a multiplication, so binary float error reaches the invoice with it."
    },
    "time_entry.band_hours": {
      "sql": "DECIMAL(9,2)",
      "why": "The uplift numerator. Bands are 0.5/2/4/8/20, all exact in DECIMAL and none of them exact in binary FLOAT."
    },
    "capacity_declaration.hours_per_month": {
      "sql": "DECIMAL(9,2)",
      "why": "The uplift denominator, offered to the client for initialling. A denominator that does not compare equal to the number on the paper is indefensible."
    },
    "sla_target.attainment_percent": {
      "sql": "DECIMAL(5,2)",
      "why": "A population percentile, reported not invoiced. DECIMAL anyway, so no number in this schema is a float."
    },
    "sla_target_type.attainment_percent": {
      "sql": "DECIMAL(5,2)",
      "why": "As sla_target.attainment_percent: a population percentile, reported not invoiced."
    },
    "time_entry.hours_deduct": {
      "sql": "DECIMAL(9,2)",
      "why": "Hours deducted from a start-to-end span (Dada PSA's hoursDeduct); exact, like band_hours."
    },
    "time_entry.actual_hours": {
      "sql": "DECIMAL(9,2)",
      "why": "Dada PSA's actualHours, rounded to the quarter hour; band_hours is derived from it and both must compare exactly."
    },
    "project.budget_hours": {
      "sql": "DECIMAL(9,2)",
      "why": "Budget hours, compared with the sum of time entries' actual hours; both must compare exactly."
    },
    "project_phase.budget_hours": {
      "sql": "DECIMAL(9,2)",
      "why": "Budget hours, compared with the sum of time entries' actual hours; both must compare exactly."
    },
    "ext_agreement.amount": {
      "sql": "DECIMAL(19,4)",
      "why": "Money mirrored from BizBox. FLOAT cannot represent a centavo exactly, and this number is compared with BizBox's own."
    },
    "ext_product.unit_cost": {
      "sql": "DECIMAL(19,4)",
      "why": "A unit cost mirrored from BizBox; money, so exact."
    },
    "ext_purchase_order.total": {
      "sql": "DECIMAL(19,4)",
      "why": "Money mirrored from BizBox. FLOAT cannot represent a centavo exactly, and this number is compared with BizBox's own."
    },
    "ext_invoice.total": {
      "sql": "DECIMAL(19,4)",
      "why": "Money mirrored from BizBox. FLOAT cannot represent a centavo exactly, and this number is compared with BizBox's own."
    },
    "ext_po_line.quantity": {
      "sql": "DECIMAL(19,4)",
      "why": "A quantity or unit cost mirrored from BizBox; compared with BizBox's own, so exact."
    },
    "ext_po_line.received_qty": {
      "sql": "DECIMAL(19,4)",
      "why": "A quantity or unit cost mirrored from BizBox; compared with BizBox's own, so exact."
    },
    "ext_po_line.unit_cost": {
      "sql": "DECIMAL(19,4)",
      "why": "A quantity or unit cost mirrored from BizBox; compared with BizBox's own, so exact."
    },
    "agreement.amount": {
      "sql": "DECIMAL(19,4)",
      "why": "The agreed amount, typed on the desk and compared with the sum of BizBox's totals; money, so exact."
    },
    "member_capacity.hours_per_week": {
      "sql": "DECIMAL(9,2)",
      "why": "Hours a week a person records against, the denominator of the team's own utilisation figure; a half hour is exact in DECIMAL."
    },
    "opportunity.amount": {
      "sql": "DECIMAL(19,4)",
      "why": "Money on a quote or an opportunity: a proposal's number is compared with an invoice's, and FLOAT cannot hold a cent exactly."
    },
    "quote.subtotal": {
      "sql": "DECIMAL(19,4)",
      "why": "Money on a quote or an opportunity: a proposal's number is compared with an invoice's, and FLOAT cannot hold a cent exactly."
    },
    "quote.total": {
      "sql": "DECIMAL(19,4)",
      "why": "Money on a quote or an opportunity: a proposal's number is compared with an invoice's, and FLOAT cannot hold a cent exactly."
    },
    "quote_line.unit_price": {
      "sql": "DECIMAL(19,4)",
      "why": "Money on a quote or an opportunity: a proposal's number is compared with an invoice's, and FLOAT cannot hold a cent exactly."
    },
    "quote_line.line_total": {
      "sql": "DECIMAL(19,4)",
      "why": "Money on a quote or an opportunity: a proposal's number is compared with an invoice's, and FLOAT cannot hold a cent exactly."
    },
    "quote.tax_percent": {
      "sql": "DECIMAL(5,2)",
      "why": "A VAT rate: 12.00, exact."
    },
    "quote_line.quantity": {
      "sql": "DECIMAL(12,3)",
      "why": "A count or a length; 0.5 of a day is exact in DECIMAL and not in binary FLOAT."
    },
    "project_ticket.budget_hours": {
      "sql": "DECIMAL(9,2)",
      "why": "A project ticket's budget, as its phase's and project's are (068)."
    },
    "project_member.hours": {
      "sql": "DECIMAL(9,2)",
      "why": "Hours planned for a team member on a project (068); the same unit as the budget."
    },
    "project_plan_item.budget_hours": {
      "sql": "DECIMAL(9,2)",
      "why": "A template's planned ticket budget (069), the unit of every project budget."
    }
  },
