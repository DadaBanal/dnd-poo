# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Nothing in this file is a PMC value: fill them from the record at deploy time.

# --- Orthanc -----------------------------------------------------------------
ORTHANC_AE_TITLE=CHANGEME-AE
ORTHANC_DICOM_PORT=4242

# --- PostgreSQL index (ADR-001) ----------------------------------------------
PG_HOST=orthanc-index
PG_PORT=5432
PG_DATABASE=orthanc
PG_USER=orthanc
PG_PASSWORD=                 # set at deploy time; never commit a value here

# --- Keycloak (brokers to Entra ID) ------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=     # set at deploy time
KEYCLOAK_HOSTNAME=CHANGEME.example.internal
OIDC_CLIENT_ID=ohif
OIDC_CLIENT_SECRET=          # set at deploy time
