{
  "realm": "pmc",
  "enabled": true,
  "displayName": "PMC Imaging",
  "displayNameHtml": "<img class=\"pmc-lockup\" src=\"/brand/pmc-lockup-white.png\" alt=\"Premiere Medical Center Nueva Ecija\"><p class=\"pmc-product\">PMC <b>Imaging</b></p><span class=\"pmc-rule\"></span><p class=\"pmc-what\">Every study PMC takes, the reading list and the viewer, in one place.</p><p class=\"pmc-tag\">Better Care. <i>For Every Life.</i></p>",
  "loginTheme": "pmc",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 43200,
  "roles": {
    "realm": [
      {
        "name": "pmc-radiologist",
        "description": "Reads imaging: searches, views and downloads studies."
      },
      {
        "name": "pmc-cardiologist",
        "description": "Reads cathlab and echo: searches, views and downloads studies."
      },
      {
        "name": "pmc-technologist",
        "description": "Checks their own images: searches and views studies."
      },
      {
        "name": "pmc-referrer",
        "description": "Referring doctor: views only the studies shared with referrers (label referrer-shared)."
      },
      {
        "name": "pmc-ict-admin",
        "description": "ICT: everything, including modalities, worklists, uploads and deletion."
      },
      {
        "name": "pmc-service",
        "description": "The platform's own services (connector, monitoring, tests). Never given to a person."
      }
    ]
  },
  "groups": [
    {
      "name": "${PMC_AD_GROUP_RADIOLOGISTS}",
      "path": "/${PMC_AD_GROUP_RADIOLOGISTS}",
      "realmRoles": [
        "pmc-radiologist"
      ]
    },
    {
      "name": "${PMC_AD_GROUP_CARDIOLOGISTS}",
      "path": "/${PMC_AD_GROUP_CARDIOLOGISTS}",
      "realmRoles": [
        "pmc-cardiologist"
      ]
    },
    {
      "name": "${PMC_AD_GROUP_TECHNOLOGISTS}",
      "path": "/${PMC_AD_GROUP_TECHNOLOGISTS}",
      "realmRoles": [
        "pmc-technologist"
      ]
    },
    {
      "name": "${PMC_AD_GROUP_REFERRERS}",
      "path": "/${PMC_AD_GROUP_REFERRERS}",
      "realmRoles": [
        "pmc-referrer"
      ]
    },
    {
      "name": "${PMC_AD_GROUP_ICT_ADMINS}",
      "path": "/${PMC_AD_GROUP_ICT_ADMINS}",
      "realmRoles": [
        "pmc-ict-admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "pmc-front-door",
      "name": "PMC front door",
      "description": "oauth2-proxy at the front door holds the session for every person; nothing else signs in.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PMC_FRONT_DOOR_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://${PMC_HOSTNAME}/oauth2/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${PMC_HOSTNAME}/*",
        "access.token.lifespan": "${PMC_ACCESS_TOKEN_SECONDS}"
      }
    },
    {
      "clientId": "admin-cli",
      "name": "orthanc-auth-service",
      "description": "Used only by orthanc-auth-service to look up service accounts by API key. Read-only on users and the realm.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PMC_ADMIN_CLI_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-admin-cli",
      "enabled": true,
      "serviceAccountClientId": "admin-cli",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "svc-platform",
      "enabled": true,
      "attributes": {
        "api-key": [
          "${PMC_SVC_PLATFORM_API_KEY}"
        ]
      },
      "realmRoles": [
        "pmc-service"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"api-key\",\"displayName\":\"API key (service accounts only)\",\"validations\":{},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ],
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "pmc-active-directory",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": [
                  "sAMAccountName"
                ],
                "user.model.attribute": [
                  "username"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": [
                  "givenName"
                ],
                "user.model.attribute": [
                  "firstName"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": [
                  "sn"
                ],
                "user.model.attribute": [
                  "lastName"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": [
                  "mail"
                ],
                "user.model.attribute": [
                  "email"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "account controls",
              "providerId": "msad-user-account-control-mapper",
              "subComponents": {},
              "config": {
                "always.read.enabled.value.from.ldap": [
                  "true"
                ],
                "password.policy.hints.enabled": [
                  "false"
                ]
              }
            },
            {
              "name": "imaging groups",
              "providerId": "group-ldap-mapper",
              "subComponents": {},
              "config": {
                "groups.dn": [
                  "${PMC_AD_GROUPS_DN}"
                ],
                "group.name.ldap.attribute": [
                  "cn"
                ],
                "group.object.classes": [
                  "group"
                ],
                "preserve.group.inheritance": [
                  "false"
                ],
                "ignore.missing.groups": [
                  "true"
                ],
                "membership.ldap.attribute": [
                  "member"
                ],
                "membership.attribute.type": [
                  "DN"
                ],
                "membership.user.ldap.attribute": [
                  "sAMAccountName"
                ],
                "groups.ldap.filter": [
                  ""
                ],
                "mode": [
                  "READ_ONLY"
                ],
                "user.roles.retrieve.strategy": [
                  "LOAD_GROUPS_BY_MEMBER_ATTRIBUTE_RECURSIVELY"
                ],
                "memberof.ldap.attribute": [
                  "memberOf"
                ],
                "mapped.group.attributes": [
                  ""
                ],
                "drop.non.existing.groups.during.sync": [
                  "false"
                ],
                "groups.path": [
                  "/"
                ]
              }
            }
          ]
        },
        "config": {
          "enabled": [
            "true"
          ],
          "priority": [
            "0"
          ],
          "vendor": [
            "ad"
          ],
          "connectionUrl": [
            "${PMC_AD_URL}"
          ],
          "startTls": [
            "false"
          ],
          "useTruststoreSpi": [
            "always"
          ],
          "connectionPooling": [
            "true"
          ],
          "connectionTimeout": [
            "5000"
          ],
          "readTimeout": [
            "10000"
          ],
          "authType": [
            "simple"
          ],
          "bindDn": [
            "${PMC_AD_BIND_DN}"
          ],
          "bindCredential": [
            "${PMC_AD_BIND_PASSWORD}"
          ],
          "usersDn": [
            "${PMC_AD_USERS_DN}"
          ],
          "userObjectClasses": [
            "person, organizationalPerson, user"
          ],
          "customUserSearchFilter": [
            "(&(objectCategory=person)(objectClass=user))"
          ],
          "usernameLDAPAttribute": [
            "sAMAccountName"
          ],
          "rdnLDAPAttribute": [
            "cn"
          ],
          "uuidLDAPAttribute": [
            "objectGUID"
          ],
          "searchScope": [
            "2"
          ],
          "pagination": [
            "true"
          ],
          "editMode": [
            "READ_ONLY"
          ],
          "importEnabled": [
            "true"
          ],
          "syncRegistrations": [
            "false"
          ],
          "trustEmail": [
            "true"
          ],
          "cachePolicy": [
            "NO_CACHE"
          ],
          "allowKerberosAuthentication": [
            "false"
          ],
          "useKerberosForPasswordAuthentication": [
            "false"
          ],
          "validatePasswordPolicy": [
            "false"
          ],
          "batchSizeForSync": [
            "1000"
          ],
          "fullSyncPeriod": [
            "-1"
          ],
          "changedSyncPeriod": [
            "-1"
          ],
          "krbPrincipalAttribute": [
            "userPrincipalName"
          ]
        }
      }
    ]
  }
}
