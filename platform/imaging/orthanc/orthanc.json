{
  // PMC imaging engine: configuration as versioned code (Path A, WS23).
  //
  // Nothing site-specific and no secret lives in this file:
  //   - the AE title comes from compose (PMC_DICOM_AET);
  //   - passwords come from Docker secrets (tools/make-secrets.sh);
  //   - who may do what is the Authorization block below, per role in
  //     identity/auth-service/permissions.json. There are no HTTP users;
  //   - modality addresses live in the engine's own database, registered at
  //     runtime from a private inventory. They never enter git.
  //
  // The orthancteam image merges this file with /run/secrets/*.json and the
  // ORTHANC__* environment. Plugins are enabled by the presence of their
  // section below; anything without a section stays off (the tests check the
  // exact set).

  "Name": "PMC-IMAGING",
  "DicomPort": 4242,
  "HttpPort": 8042,

  // Orthanc derives its default identifier from the MAC addresses, and Docker
  // gives the container new ones at every start. Pinned so the index and the
  // Housekeeper's progress survive a restart.
  "DatabaseServerIdentifier": "pmc-imaging-engine",

  // ---- DICOM network: only known modalities, each from its own address ----
  // A modality must call this engine's AE title, be registered under its own
  // AE title, and connect from the address it was registered with. C-ECHO
  // stays open so a technologist can test a link without ICT.
  "DicomCheckCalledAet": true,
  "DicomCheckModalityHost": true,
  "DicomAlwaysAllowEcho": true,
  "DicomAlwaysAllowStore": false,
  "DicomAlwaysAllowFind": false,
  "DicomAlwaysAllowFindWorklist": false,
  "DicomAlwaysAllowGet": false,
  "DicomAlwaysAllowMove": false,
  "DicomModalitiesInDatabase": true,
  "DicomModalities": {},
  "OrthancPeersInDatabase": true,
  "OrthancPeers": {},

  // ---- Storage ----
  "StorageDirectory": "/var/lib/orthanc/db",
  // An archive never recycles. Zero means no limit, so nothing is ever
  // deleted to make room. Stated here so a later edit has to be deliberate.
  "MaximumStorageSize": 0,
  "MaximumPatientCount": 0,
  "StorageCompression": false,
  "StoreMD5ForAttachments": true,

  // JPEG-LS lossless on arrival. The record MEASURED it 30-37% smaller on
  // PMC's own files; tests/test_ingest.py proves it bit-exact. Anything that
  // arrives already compressed (lossy ultrasound, for one) is kept exactly as
  // sent: re-encoding lossy pixels would lose more.
  "IngestTranscoding": "1.2.840.10008.1.2.4.80",
  "IngestTranscodingOfUncompressed": true,
  "IngestTranscodingOfCompressed": false,

  // Tags the index answers without opening files: the set Orthanc 1.13.0
  // recommends for DICOMweb (MEASURED from its default configuration). They
  // must be right before the first study arrives. Changing them later makes
  // the Housekeeper re-read every file, which after the migration is 6.3 TB.
  "ExtraMainDicomTags": {
    "Instance": [
      "Rows",
      "Columns",
      "ImageType",
      "SOPClassUID",
      "ContentDate",
      "ContentTime",
      "FrameOfReferenceUID",
      "PixelSpacing",
      "SpecificCharacterSet",
      "BitsAllocated"
    ],
    "Series": [],
    "Study": [],
    "Patient": []
  },

  // A study is "stable" 60 s after its last image. Stability triggers the
  // DICOMweb metadata cache and the removal of a performed worklist entry.
  "StableAge": 60,
  "SaveJobs": true,

  // ---- Operations ----
  // Idle HTTP connections stay open 10 s (Orthanc's default is 1 s). A client
  // that reuses a connection just as the engine closes it gets a dropped
  // request (MEASURED in the tests, 23 Sep); the front door closes its own idle
  // connections to the engine sooner, at 5 s, so it never races.
  "KeepAlive": true,
  "KeepAliveTimeout": 10,
  "DeidentifyLogs": true,
  "WebDavEnabled": false,
  "MetricsEnabled": true,

  // ---- HTTP: who may do what ----
  // Reachable only on the engine network. People arrive through the front
  // door, signed in with Entra ID; the platform's own services present an API
  // key. Orthanc's own user list is off: every request is decided by the
  // authorization plugin below, which asks orthanc-auth-service who the
  // caller is and checks the permission this table requires. A route the
  // table does not name is refused. DICOM from the modalities does not pass
  // through here, so ingest keeps working even while sign-in is down.
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": false,

  "Authorization": {
    "WebServiceRootUrl": "http://auth-service:8000/",
    "WebServiceUsername": "orthanc-engine",
    // WebServicePassword: the secret ORTHANC__AUTHORIZATION__WEB_SERVICE_PASSWORD
    "TokenHttpHeaders": ["Authorization", "api-key"],
    "CheckedLevel": "studies",
    // Downloads, uploads, modifications and deletions are written to the
    // engine's audit log. Who opened which study is in the front door's log.
    "EnableAuditLogs": true,
    "Permissions": [
      // The permission names are orthanc-auth-service's own (a fixed list,
      // MEASURED in 26.8.1): "api-view" is used here for searching, "view"
      // for reading one study. What a search returns is also cut to the
      // labels a role may see: the plugin rewrites DICOMweb and /tools/find
      // searches itself (MEASURED in its 0.12.0 source), so a referrer's
      // search finds only the studies shared with referrers.
      //
      // DICOMweb, as the viewer uses it.
      ["get", "^/dicom-web/(studies|series|instances)$", "api-view"],
      ["get", "^/dicom-web/studies/[^/]+/(series|instances)$", "api-view"],
      ["get", "^/dicom-web/studies/[^/]+/series/[^/]+/instances$", "api-view"],
      ["get", "^/dicom-web/studies/[^/]+(/series/[^/]+(/instances/[^/]+)?)?(/(metadata|rendered|thumbnail|frames/[0-9,]+(/(rendered|thumbnail))?|bulk/.+))?$", "view"],
      ["get", "^/wado$", "view"],

      // The REST API, as the front door's backend and the platform's tools read it.
      ["post", "^/tools/(find|lookup)$", "api-view"],
      ["get", "^/changes$", "api-view"],
      ["get", "^/system$", "view"],
      ["get", "^/(patients|studies|series|instances)/[a-f0-9-]+(/(patient|study|series|instances|shared-tags|tags|simplified-tags|header|statistics|metadata(/[^/]+)?|labels(/[^/]+)?|preview|rendered|numpy|content(/.*)?|frames(/[0-9]+(/(preview|rendered|numpy|raw|image-uint8|image-uint16|image-int16))?)?))?$", "view"],
      ["get", "^/(patients|studies|series|instances)/[a-f0-9-]+/(archive|media|file)$", "download"],

      // Modality worklists, as the BizBox connector keeps them (M3).
      ["get", "^/worklists(/[^/]+)?$", "worklists"],
      ["post", "^/worklists/create$", "worklists"],
      ["delete", "^/worklists/[^/]+$", "worklists"],

      // Administration: ICT and the platform's own tools.
      ["get", "^/(modalities|plugins|statistics|jobs)(/.*)?$", "admin-permissions"],
      ["put", "^/modalities/[^/]+$", "admin-permissions"],
      ["delete", "^/modalities/[^/]+$", "admin-permissions"],
      ["get", "^/(patients|studies|series|instances)/[a-f0-9-]+/attachments(/.*)?$", "admin-permissions"],
      ["put", "^/(patients|studies|series|instances)/[a-f0-9-]+/labels/[^/]+$", "edit-labels"],
      ["delete", "^/(patients|studies|series|instances)/[a-f0-9-]+/labels/[^/]+$", "edit-labels"],
      ["post", "^/instances$", "upload"],
      ["delete", "^/(patients|studies|series|instances)/[a-f0-9-]+$", "delete"]
    ]
  },

  // ---- Index: PostgreSQL (ADR-001) ----
  // The password arrives as the secret ORTHANC__POSTGRESQL__PASSWORD.
  // Lock stays off: a lock held by a killed container's dead session can
  // block the restart that would recover it. Compose runs one engine.
  "PostgreSQL": {
    "EnableIndex": true,
    "EnableStorage": false,
    "Host": "pg-index",
    "Port": 5432,
    "Database": "orthanc",
    "Username": "orthanc",
    "EnableSsl": false,
    "Lock": false,
    "ApplicationName": "pmc-imaging-engine"
  },

  // ---- DICOMweb: the only way viewers reach images ----
  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado",
    "StudiesMetadata": "Full",
    "SeriesMetadata": "Full",
    "EnableMetadataCache": true
  },

  // ---- Modality worklists, kept in the index ----
  // Orders arrive through the REST API (the BizBox connector, M3). A modality
  // sees only the entries scheduled for its own AE title. An entry goes when
  // its study has arrived and is stable, or after 72 h if it never happens.
  "Worklists": {
    "Enable": true,
    "SaveInOrthancDatabase": true,
    "FilterIssuerAet": true,
    "SetStudyInstanceUidIfMissing": true,
    "DeleteWorklistsOnStableStudy": true,
    "HousekeepingInterval": 60,
    "DeleteWorklistsDelay": 72
  },

  // ---- Housekeeper: clean-up after configuration changes ----
  // Off-hours only, in PMC's local time (the container runs in Asia/Manila):
  // weekday nights and all weekend.
  "Housekeeper": {
    "Enable": true,
    "GlobalPropertyId": 1025,
    "ThrottleDelay": 5,
    "Schedule": {
      "Monday": ["0-6", "20-24"],
      "Tuesday": ["0-6", "20-24"],
      "Wednesday": ["0-6", "20-24"],
      "Thursday": ["0-6", "20-24"],
      "Friday": ["0-6", "20-24"],
      "Saturday": ["0-24"],
      "Sunday": ["0-24"]
    }
  }
}
